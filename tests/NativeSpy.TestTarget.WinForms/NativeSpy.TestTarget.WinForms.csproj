<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>NativeSpy.TestTarget.WinForms</AssemblyName>
    <RootNamespace>NativeSpy.TestTarget.WinForms</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\NativeSpy.Agent.WinForms\NativeSpy.Agent.WinForms.csproj" />
    <ProjectReference Include="..\..\src\NativeSpy.Agent.Host\NativeSpy.Agent.Host.csproj" />
    <ProjectReference Include="..\..\src\NativeSpy.Agent.Host.WinForms\NativeSpy.Agent.Host.WinForms.csproj" />
    <ProjectReference Include="..\..\src\NativeSpy.Protocol.Json\NativeSpy.Protocol.Json.csproj" />
    <ProjectReference Include="..\..\src\NativeSpy.Transport.NamedPipes\NativeSpy.Transport.NamedPipes.csproj" />
    <ProjectReference Include="..\..\src\NativeSpy.Agent\NativeSpy.Agent.csproj" />
    <ProjectReference Include="..\..\src\NativeSpy.Protocol\NativeSpy.Protocol.csproj" />
  </ItemGroup>
  <Target Name="GetNativeSpyTestTargetArtifacts" Returns="@(NativeSpyTestTargetArtifacts)">
    <ItemGroup>
      <NativeSpyTestTargetArtifacts Include="$(TargetDir)*.*" />
    </ItemGroup>
  </Target>
</Project>
