<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>NativeSpy.TestTarget.Wpf</AssemblyName>
    <RootNamespace>NativeSpy.TestTarget.Wpf</RootNamespace>
  </PropertyGroup>
  <Target Name="GetNativeSpyWpfTestTargetArtifacts" Returns="@(NativeSpyWpfTestTargetArtifacts)">
    <ItemGroup>
      <NativeSpyWpfTestTargetArtifacts Include="$(TargetDir)*.*" />
    </ItemGroup>
  </Target>
</Project>
