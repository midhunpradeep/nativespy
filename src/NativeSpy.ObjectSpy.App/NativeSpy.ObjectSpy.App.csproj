<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>NativeSpy.ObjectSpy.App</AssemblyName>
    <RootNamespace>NativeSpy.ObjectSpy.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\NativeSpy.ObjectSpy\NativeSpy.ObjectSpy.csproj" />
    <ProjectReference Include="..\NativeSpy.FlaUI\NativeSpy.FlaUI.csproj" />
    <ProjectReference Include="..\NativeSpy.Client.NamedPipes\NativeSpy.Client.NamedPipes.csproj" />
    <ProjectReference Include="..\NativeSpy.Protocol.Json\NativeSpy.Protocol.Json.csproj" />
    <ProjectReference Include="..\NativeSpy.Transport.NamedPipes\NativeSpy.Transport.NamedPipes.csproj" />
    <ProjectReference Include="..\NativeSpy.Protocol\NativeSpy.Protocol.csproj" />
    <TestTargetProjectReference Include="..\..\tests\NativeSpy.TestTarget.WinForms\NativeSpy.TestTarget.WinForms.csproj" />
    <ProjectReference Include="@(TestTargetProjectReference)" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyControlledTargetArtifacts" AfterTargets="Build">
    <MSBuild
      Projects="@(TestTargetProjectReference)"
      Targets="GetNativeSpyTestTargetArtifacts"
      Properties="Configuration=$(Configuration);Platform=$(Platform)">
      <Output TaskParameter="TargetOutputs" ItemName="ControlledTargetArtifacts" />
    </MSBuild>
    <Copy
      SourceFiles="@(ControlledTargetArtifacts)"
      DestinationFiles="@(ControlledTargetArtifacts->'$(TargetDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
