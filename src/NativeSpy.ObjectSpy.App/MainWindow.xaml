<Window x:Class="NativeSpy.ObjectSpy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NativeSpy ObjectSpy Lite"
        Width="1000"
        Height="720"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button x:Name="FinderButton" Width="130" Margin="0,0,8,0" Click="FinderButton_OnClick">Activate finder</Button>
            <Button x:Name="FixButton" Width="110" Margin="0,0,8,0" Click="FixButton_OnClick" IsEnabled="False">Fix selection</Button>
            <Button x:Name="BackButton" Width="90" Click="BackButton_OnClick" IsEnabled="False">Back</Button>
            <TextBlock x:Name="ConnectionText" Margin="18,4,0,0" />
        </StackPanel>

        <TextBlock Grid.Row="1" x:Name="StateText" Margin="0,10,0,10" FontWeight="SemiBold" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <GroupBox Header="Selected external element" Margin="0,0,0,10">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Name" />
                            <TextBlock Grid.Row="1" Text="ControlType" />
                            <TextBlock Grid.Row="2" Text="AutomationId" />
                            <TextBlock Grid.Row="3" Text="ClassName" />
                            <TextBlock Grid.Row="4" Text="Candidate HWND" />
                            <TextBlock Grid.Row="5" Text="Root HWND" />
                            <TextBlock Grid.Row="6" Text="ProcessId" />
                            <TextBlock Grid.Column="1" Grid.Row="0" x:Name="NameText" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Grid.Row="1" x:Name="ControlTypeText" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Grid.Row="2" x:Name="AutomationIdText" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Grid.Row="3" x:Name="ClassNameText" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Grid.Row="4" x:Name="CandidateHwndText" />
                            <TextBlock Grid.Column="1" Grid.Row="5" x:Name="RootHwndText" />
                            <TextBlock Grid.Column="1" Grid.Row="6" x:Name="ProcessIdText" />
                        </Grid>
                    </GroupBox>
                    <GroupBox Header="Correlation">
                        <StackPanel Margin="8">
                            <TextBlock x:Name="CorrelationText" TextWrapping="Wrap" />
                            <TextBlock x:Name="ManagedTypeText" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <GroupBox Header="CLR inspection">
                        <StackPanel x:Name="ClrPanel" Margin="8" />
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="ErrorText" Margin="0,10,0,0" Foreground="Firebrick" TextWrapping="Wrap" />
    </Grid>
</Window>
